#!/usr/bin/env bash
#
# wgpanel - management CLI for the WGPanel control-plane stack.
# Installed to /usr/local/bin/wgpanel by deploy/install.sh.
#
set -euo pipefail

INSTALL_DIR="/opt/wgpanel"
# The optional self-node (install.sh) runs as its own compose project here.
NODE_DIR="/opt/wgpanel-node"
ENV_FILE="$INSTALL_DIR/.env"
BACKUP_DIR="$INSTALL_DIR/backups"
STATE_DIR="$INSTALL_DIR/state"
LAST_GOOD_FILE="$STATE_DIR/last-known-good-images.txt"
BACKUP_RETENTION_DAYS="${WGPANNEL_BACKUP_RETENTION_DAYS:-14}"
HEALTH_TIMEOUT_SECONDS="${WGPANNEL_HEALTH_TIMEOUT_SECONDS:-90}"

log()  { echo -e "\033[1;32m[wgpanel]\033[0m $*"; }
warn() { echo -e "\033[1;33m[wgpanel]\033[0m $*"; }
err()  { echo -e "\033[1;31m[wgpanel]\033[0m $*" >&2; }

cd "$INSTALL_DIR"

env_get() { grep "^${1}=" "$ENV_FILE" | head -n1 | cut -d= -f2-; }

api_port() { env_get API_PORT; }
internal_token() { env_get INTERNAL_API_TOKEN; }
panel_url() {
  local domain port
  domain="$(env_get PANEL_DOMAIN)"
  port="$(env_get PANEL_HTTPS_PORT)"
  if [[ -z "$port" || "$port" == "443" ]]; then
    echo "https://${domain}"
  else
    echo "https://${domain}:${port}"
  fi
}

# curl wrapper for /internal/* calls: attaches the shared secret required by the API's
# internal-token middleware (see docs/PRD-security-access-control.md §5) - loopback/Caddy
# routing alone doesn't stop a sibling container from reaching api:8080 directly.
internal_curl() {
  curl -fsS -H "X-Internal-Token: $(internal_token)" "$@"
}

# ---- health ----

wait_for_health() {
  local timeout="${1:-$HEALTH_TIMEOUT_SECONDS}" waited=0
  local port; port="$(api_port)"
  log "Waiting for API to become healthy (timeout ${timeout}s)..."
  while (( waited < timeout )); do
    if internal_curl "http://127.0.0.1:${port}/internal/healthz" >/dev/null 2>&1; then
      return 0
    fi
    sleep 3
    waited=$((waited + 3))
  done
  return 1
}

cmd_status() {
  docker compose ps
  echo
  local port; port="$(api_port)"
  if internal_curl "http://127.0.0.1:${port}/internal/healthz" 2>/dev/null; then
    echo
    log "API: healthy"
  else
    warn "API: not responding on /internal/healthz"
  fi
  echo
  log "Panel address: $(panel_url)"
}

cmd_doctor() {
  echo "== wgpanel doctor =="

  # Disk space
  local avail_kb; avail_kb=$(df -Pk "$INSTALL_DIR" | tail -1 | awk '{print $4}')
  if (( avail_kb < 2*1024*1024 )); then
    warn "Low disk space: $((avail_kb/1024))MB free under $INSTALL_DIR"
  else
    log "Disk space OK: $((avail_kb/1024))MB free"
  fi

  # Container health
  if docker compose ps --status running --format '{{.Name}}' | grep -q .; then
    log "Containers running: $(docker compose ps --status running --format '{{.Name}}' | tr '\n' ' ')"
  else
    err "No containers are running - try: wgpanel start"
  fi

  # DB reachability
  if docker compose exec -T db pg_isready -U "$(env_get POSTGRES_USER)" >/dev/null 2>&1; then
    log "Postgres/Timescale: reachable"
  else
    err "Postgres/Timescale: NOT reachable"
  fi

  # Redis reachability
  if docker compose exec -T redis redis-cli -a "$(env_get REDIS_PASSWORD)" ping >/dev/null 2>&1; then
    log "Redis: reachable"
  else
    err "Redis: NOT reachable"
  fi

  # API internal health
  if internal_curl "http://127.0.0.1:$(api_port)/internal/healthz" >/dev/null 2>&1; then
    log "API: healthy"
  else
    err "API: NOT healthy"
  fi

  # TLS cert expiry
  local domain; domain="$(env_get PANEL_DOMAIN)"
  local exp
  exp=$(echo | openssl s_client -servername "$domain" -connect "${domain}:443" 2>/dev/null \
        | openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2 || true)
  if [[ -n "$exp" ]]; then
    log "TLS cert for ${domain} expires: ${exp}"
  else
    warn "Could not read TLS cert for ${domain} (may still be provisioning)"
  fi

  # Backup hygiene
  # Newest backup by mtime, via -nt rather than parsing ls output.
  local latest="" f
  for f in "$BACKUP_DIR"/wgpanel-backup-*.tar.gz; do
    [[ -f "$f" ]] || continue
    if [[ -z "$latest" || "$f" -nt "$latest" ]]; then
      latest="$f"
    fi
  done
  if [[ -z "$latest" ]]; then
    warn "No backups found yet - run: wgpanel backup"
  else
    local age_days=$(( ( $(date +%s) - $(stat -c %Y "$latest" 2>/dev/null || stat -f %m "$latest") ) / 86400 ))
    if (( age_days > 2 )); then
      warn "Latest backup is ${age_days} day(s) old (${latest}) - consider running: wgpanel backup"
    else
      log "Latest backup: ${latest} (${age_days}d old)"
    fi
  fi

  echo "== end doctor report =="
}

# ---- lifecycle ----

cmd_start()   { docker compose up -d; }
cmd_stop()    { docker compose down; }
cmd_restart() { docker compose restart "${1:-}"; }
cmd_logs()    { docker compose logs -f --tail=200 "${1:-}"; }

# ---- backup / restore ----

cmd_backup() {
  mkdir -p "$BACKUP_DIR"
  local ts; ts="$(date +%Y%m%d-%H%M%S)"
  local workdir; workdir="$(mktemp -d)"
  # `trap ... RETURN` is NOT scoped to this function - it stays armed for the
  # RETURN of whatever function executes next in the same shell (e.g. cmd_update,
  # which calls cmd_backup as one step among several). Without resetting it before
  # returning, it re-fires later against a $workdir that's already out of scope,
  # which under `set -u` is "workdir: unbound variable" - a real bug hit live,
  # surfacing at a completely unrelated point later in the script.
  trap 'rm -rf "$workdir"; trap - RETURN' RETURN

  log "Dumping database..."
  docker compose exec -T db pg_dump -U "$(env_get POSTGRES_USER)" "$(env_get POSTGRES_DB)" > "$workdir/db.sql"
  cp "$ENV_FILE" "$workdir/.env"

  local archive="$BACKUP_DIR/wgpanel-backup-${ts}.tar.gz"
  tar czf "$archive" -C "$workdir" db.sql .env
  log "Backup written to $archive"

  # Retention: prune backups older than WGPANNEL_BACKUP_RETENTION_DAYS
  find "$BACKUP_DIR" -name 'wgpanel-backup-*.tar.gz' -mtime "+${BACKUP_RETENTION_DAYS}" -print -delete \
    | sed 's/^/  pruned old backup: /' || true
}

cmd_restore() {
  local archive="${1:-}"
  if [[ -z "$archive" || ! -f "$archive" ]]; then
    err "Usage: wgpanel restore <backup-file.tar.gz>"
    exit 1
  fi
  read -rp "This will OVERWRITE the current database with the contents of ${archive}. Type 'yes' to confirm: " c
  [[ "$c" == "yes" ]] || { log "Aborted."; exit 0; }

  local workdir; workdir="$(mktemp -d)"
  # See cmd_backup's comment above - RETURN traps aren't function-scoped in bash, so
  # this must reset itself before returning or it re-fires later against an
  # out-of-scope $workdir.
  trap 'rm -rf "$workdir"; trap - RETURN' RETURN
  tar xzf "$archive" -C "$workdir"

  log "Restoring database..."
  cat "$workdir/db.sql" | docker compose exec -T db psql -U "$(env_get POSTGRES_USER)" "$(env_get POSTGRES_DB)"
  log "Restore complete. Restart the API to pick up any state changes: wgpanel restart api"
}

# ---- update / rollback ----

# update_self_node_container pulls + recreates the self-node container so `wgpanel
# update` refreshes the node image too, not just the panel stack. The node runs as
# its own compose project under NODE_DIR (install.sh's setup_self_node); this is a
# no-op on a panel-only host where that dir doesn't exist. Replaces the old
# bare-metal wg0.conf patcher - the node's NAT/forwarding now lives inside the
# container image (node-entrypoint.sh), so there's no host config to patch.
update_self_node_container() {
  [[ -f "$NODE_DIR/docker-compose.yml" ]] || return 0
  log "Updating the self-node container..."
  ( cd "$NODE_DIR" && docker compose pull && docker compose up -d ) \
    || warn "Could not update the self-node container - check: cd $NODE_DIR && docker compose logs"
}

cmd_update() {
  log "Taking a pre-update backup..."
  cmd_backup

  mkdir -p "$STATE_DIR"
  log "Recording current image versions for rollback..."
  docker compose images --format '{{.Repository}}:{{.Tag}}' > "$LAST_GOOD_FILE" 2>/dev/null || \
    docker compose config --images > "$LAST_GOOD_FILE"

  log "Pulling latest images..."
  docker compose pull

  log "Recreating containers..."
  # --force-recreate: plain `up -d` skips a container whose service definition
  # didn't change, even if a bind-mounted config file (Caddyfile, etc.) did -
  # `wgpanel update` should always guarantee every container is running against
  # whatever is on disk right now, not silently leave one stale.
  docker compose up -d --force-recreate

  if wait_for_health "$HEALTH_TIMEOUT_SECONDS"; then
    log "Update successful. Current versions:"
    cmd_version
    update_self_node_container
    log "Panel address: $(panel_url)"
  else
    err "Health check failed after update - rolling back to the previous known-good images."
    cmd_rollback
    exit 1
  fi
}

cmd_rollback() {
  if [[ ! -f "$LAST_GOOD_FILE" ]]; then
    err "No recorded known-good version to roll back to (nothing to do)."
    exit 1
  fi
  warn "Rolling back is best-effort: it restarts the stack against whatever images are cached locally"
  warn "from before the last 'wgpanel update'. If those images were pruned, this will not work -"
  warn "restore from a database backup instead: wgpanel restore <backup-file>"
  docker compose up -d
  if wait_for_health "$HEALTH_TIMEOUT_SECONDS"; then
    log "Rollback health check passed."
  else
    err "Rollback health check also failed - manual intervention needed."
  fi
}

cmd_version() {
  docker compose images 2>/dev/null || docker compose config --images
}

# ---- admin management ----

cmd_create_admin() {
  local username="" password=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --username) username="$2"; shift 2 ;;
      --password) password="$2"; shift 2 ;;
      *) err "Unknown flag: $1"; exit 1 ;;
    esac
  done

  if [[ -z "$username" ]]; then
    read -rp "New admin username: " username
  fi
  if [[ -z "$password" ]]; then
    password="$(openssl rand -hex 24 | cut -c1-16)"
  fi

  local port; port="$(api_port)"
  if ! internal_curl -X POST "http://127.0.0.1:${port}/internal/admins" \
    -H 'Content-Type: application/json' \
    -d "{\"username\":\"${username}\",\"password\":\"${password}\",\"role\":\"super_admin\"}" >/dev/null; then
    err "Could not create admin '${username}' - the name may be taken, or the API is down (wgpanel status)."
    exit 1
  fi

  echo
  echo "=============================================="
  echo " Super admin created - save these credentials "
  echo "=============================================="
  echo "  Username: ${username}"
  echo "  Password: ${password}"
  echo "=============================================="
  echo
}

# Re-displays the credentials the API auto-created on its very first boot against a
# fresh database (see cmd/api/main.go's bootstrapFirstAdmin) - useful if the admin
# missed them scrolling past during `install.sh`. Only ever prints something if that
# exact log line is still present in `docker compose logs api`'s retained history.
cmd_show_bootstrap_admin() {
  local creds
  creds="$(docker compose logs api 2>/dev/null | grep 'WGPANEL_INITIAL_ADMIN_' || true)"
  if [[ -z "$creds" ]]; then
    err "No bootstrap-admin credentials found in the API's current log history."
    err "Either an admin already existed before this container's first boot, or the logs have rotated/been cleared."
    err "Create a new one instead with: wgpanel create-admin --username <name>"
    exit 1
  fi
  echo "$creds" | sed -E 's/^.*(WGPANEL_INITIAL_ADMIN_[A-Z]+=.*)$/\1/'
}

# Break-glass: remove the admin IP allowlist (Settings -> Security) when an admin has
# locked themselves out of the panel. Needs shell access to this server, which is the
# point - it uses the loopback-only internal API, authenticated with the install's
# INTERNAL_API_TOKEN, so it is unaffected by the allowlist itself.
cmd_clear_ip_allowlist() {
  local port; port="$(api_port)"
  if ! internal_curl -X POST "http://127.0.0.1:${port}/internal/security/clear-allowlist" >/dev/null; then
    err "Could not clear the admin IP allowlist - is the API running? (wgpanel status)"
    exit 1
  fi
  log "Admin IP allowlist cleared - the panel is reachable from any address again."
}

# ---- destructive ----

cmd_uninstall() {
  echo "This removes WGPanel from this server completely:"
  echo "  - stops the panel stack and DELETES its data volumes (database, TLS certs, node CA)"
  if [[ -f "$NODE_DIR/docker-compose.yml" ]]; then
    echo "  - stops the self-node stack and deletes its volumes (WireGuard state)"
  fi
  echo "  - deletes ${INSTALL_DIR} (including .env and ALL backups) and ${NODE_DIR}"
  echo "  - removes this CLI (/usr/local/bin/wgpanel)"
  read -rp "Type 'yes' to confirm: " c
  if [[ "$c" != "yes" ]]; then
    log "Aborted - nothing was removed."
    return 0
  fi
  # Tear the self-node down FIRST: its agent would otherwise keep hammering the
  # just-removed control plane with re-registration attempts until reboot.
  if [[ -f "$NODE_DIR/docker-compose.yml" ]]; then
    log "Removing the self-node stack..."
    (cd "$NODE_DIR" && docker compose down -v --remove-orphans) \
      || warn "Self-node teardown failed - finish it manually: cd ${NODE_DIR} && docker compose down -v"
  fi
  log "Removing the panel stack..."
  docker compose down -v --remove-orphans \
    || warn "Panel teardown failed - finish it manually: cd ${INSTALL_DIR} && docker compose down -v"
  cd /
  rm -rf "$INSTALL_DIR" "$NODE_DIR"
  rm -f /usr/local/bin/wgpanel
  log "WGPanel uninstalled. Pulled images were kept - reclaim the space with: docker image prune -a"
}

cmd_tune() {
  local action="${1:-status}"
  case "$action" in
    status) net_tune_status ;;
    apply|revert)
      if [[ "$EUID" -ne 0 ]]; then
        err "wgpanel tune ${action} must run as root (sudo wgpanel tune ${action})"
        exit 1
      fi
      "net_tune_${action}"
      ;;
    *) err "Usage: wgpanel tune [apply|status|revert]"; exit 1 ;;
  esac
}

usage() {
  cat <<'EOF'
wgpanel - manage the WGPanel control-plane stack

Usage: wgpanel <command> [args]

Lifecycle:
  start                   Start the stack
  stop                    Stop the stack (data volumes preserved)
  restart [service]       Restart everything, or one service
  status                  Show container + API health status

Day-2 operations:
  update                  Backup, pull latest images, redeploy, auto-rollback on failed health check
  rollback                Redeploy the last known-good image set (best-effort; prefer restore for real recovery)
  backup                  Dump the database + .env into deploy/backups (auto-pruned after 14 days)
  restore <file>          Restore the database from a backup archive (destructive, asks for confirmation)
  doctor                  Check disk space, container/DB/Redis health, TLS cert expiry, backup freshness
  logs [service]          Tail logs

Admin accounts:
  create-admin [--username NAME] [--password PASS]
                          Create an additional super admin (the very first one is
                          auto-created by the API itself on first boot - see
                          show-bootstrap-admin to recover those credentials)
  show-bootstrap-admin    Re-display the auto-created first-boot super admin credentials,
                          if still present in the API's log history

Recovery:
  clear-ip-allowlist      Break-glass: remove the admin IP allowlist (Settings -> Security)
                          if it locked every admin out of the panel

Network tuning (run as root):
  tune [apply|status|revert]
                          Host network tuning for WireGuard speed: BBR + fq, bigger socket
                          buffers, conntrack sizing, TCP MTU probing, UDP GRO forwarding.
                          'status' (default) shows current vs target values; 'revert'
                          removes the tuning and restores the previous values

Other:
  uninstall               Remove WGPanel completely: panel + self-node stacks, volumes,
                          /opt/wgpanel*, and this CLI (destructive, asks for confirmation)
EOF
}

# >>> wgpanel net-tune (this block is identical in install.sh, install-node.sh and wgpanel; deploy/check-net-tune-sync.sh enforces it)
# Host network tuning for WireGuard throughput: BBR + fq, bigger socket buffers and
# backlog, a conntrack table sized to RAM, TCP MTU probing, and (when the NIC supports
# it) UDP GRO forwarding. Idempotent, and never fatal: an unsupported knob is skipped.
NET_TUNE_CONF="/etc/sysctl.d/90-wgpanel-net.conf"
NET_TUNE_UNIT="/etc/systemd/system/wgpanel-net-tune.service"
NET_TUNE_NIC_SCRIPT="/usr/local/sbin/wgpanel-net-tune-nic"
NET_TUNE_PREV="/var/lib/wgpanel/net-tune.prev"

net_tune_default_iface() {
  ip route show default 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit }}'
}

# ~65536 entries per GB of RAM, clamped to 32768..262144.
net_tune_conntrack_max() {
  local mem_kb max
  mem_kb="$(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null)"
  max=$(( ${mem_kb:-0} / 16 ))
  (( max < 32768 )) && max=32768
  (( max > 262144 )) && max=262144
  echo "$max"
}

net_tune_bbr_available() {
  grep -qw bbr /proc/sys/net/ipv4/tcp_available_congestion_control 2>/dev/null && return 0
  modprobe tcp_bbr >/dev/null 2>&1 || true
  grep -qw bbr /proc/sys/net/ipv4/tcp_available_congestion_control 2>/dev/null
}

# Target sysctls as "key value" lines - the single source for apply, status and revert.
net_tune_targets() {
  if net_tune_bbr_available; then
    echo "net.core.default_qdisc fq"
    echo "net.ipv4.tcp_congestion_control bbr"
  fi
  echo "net.core.rmem_max 16777216"
  echo "net.core.wmem_max 16777216"
  echo "net.ipv4.tcp_rmem 4096 131072 16777216"
  echo "net.ipv4.tcp_wmem 4096 65536 16777216"
  echo "net.core.netdev_max_backlog 16384"
  echo "net.netfilter.nf_conntrack_max $(net_tune_conntrack_max)"
  echo "net.ipv4.tcp_mtu_probing 1"
}

net_tune_render() {
  echo "# Managed by wgpanel (wgpanel tune). Remove with: wgpanel tune revert"
  local key value
  while read -r key value; do
    # The leading "-" tells sysctl to ignore a key this kernel does not have.
    echo "-${key} = ${value}"
  done < <(net_tune_targets)
}

net_tune_nic_script() {
  cat <<'NICEOF'
#!/bin/sh
# Installed by wgpanel (wgpanel tune): UDP GRO forwarding on the default-route NIC.
dev="$(ip route show default 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit }}')"
[ -n "$dev" ] || exit 0
command -v ethtool >/dev/null 2>&1 || exit 0
ethtool -k "$dev" 2>/dev/null | grep -q '^rx-udp-gro-forwarding:' || exit 0
ethtool -K "$dev" rx-udp-gro-forwarding on rx-gro-list off >/dev/null 2>&1 || true
exit 0
NICEOF
}

net_tune_unit() {
  cat <<UNITEOF
[Unit]
Description=WGPanel NIC tuning (UDP GRO forwarding)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=${NET_TUNE_NIC_SCRIPT}

[Install]
WantedBy=multi-user.target
UNITEOF
}

# net_tune_write PATH MODE: stdin -> PATH, only touching the file when content changed.
net_tune_write() {
  local path="$1" mode="$2" tmp
  tmp="$(mktemp)" || return 1
  cat > "$tmp"
  if [[ -f "$path" ]] && cmp -s "$tmp" "$path"; then
    rm -f "$tmp"
    return 0
  fi
  install -D -m "$mode" "$tmp" "$path"
  rm -f "$tmp"
}

net_tune_apply() {
  log "Applying network tuning (BBR, socket buffers, conntrack, MTU probing)..."
  modprobe nf_conntrack >/dev/null 2>&1 || true

  # Remember the pre-tuning values once, so `wgpanel tune revert` can restore them.
  if [[ ! -f "$NET_TUNE_PREV" ]]; then
    local key value cur
    mkdir -p "$(dirname "$NET_TUNE_PREV")" 2>/dev/null || true
    while read -r key value; do
      cur="$(sysctl -n "$key" 2>/dev/null | tr '\t' ' ')" || cur=""
      [[ -n "$cur" ]] && echo "${key} ${cur}"
    done < <(net_tune_targets) > "$NET_TUNE_PREV" 2>/dev/null || true
  fi

  if net_tune_render | net_tune_write "$NET_TUNE_CONF" 644; then
    sysctl -q -p "$NET_TUNE_CONF" >/dev/null 2>&1 || warn "Some network settings are not supported by this kernel and were skipped."
  else
    warn "Could not write ${NET_TUNE_CONF} - skipping sysctl tuning."
  fi

  if ! command -v ethtool >/dev/null 2>&1 && command -v apt-get >/dev/null 2>&1; then
    DEBIAN_FRONTEND=noninteractive apt-get install -y ethtool >/dev/null 2>&1 || true
  fi
  if command -v systemctl >/dev/null 2>&1 && [[ -d /run/systemd/system ]]; then
    if net_tune_nic_script | net_tune_write "$NET_TUNE_NIC_SCRIPT" 755 && net_tune_unit | net_tune_write "$NET_TUNE_UNIT" 644; then
      systemctl daemon-reload >/dev/null 2>&1 || true
      systemctl enable wgpanel-net-tune.service >/dev/null 2>&1 || true
      systemctl restart wgpanel-net-tune.service >/dev/null 2>&1 || warn "NIC tuning service did not start (the NIC may not support UDP GRO forwarding) - continuing."
    else
      warn "Could not install the NIC tuning service - continuing."
    fi
  else
    warn "systemd not available - skipped the NIC tuning service."
  fi
  return 0
}

net_tune_status() {
  local key value cur mark iface
  printf '%-36s %-26s %-26s\n' "SETTING" "CURRENT" "TARGET"
  while read -r key value; do
    cur="$(sysctl -n "$key" 2>/dev/null | tr '\t' ' ')" || cur=""
    mark=" "
    [[ "$cur" == "$value" ]] && mark="*"
    printf '%-36s %-26s %-26s %s\n' "$key" "${cur:-n/a}" "$value" "$mark"
  done < <(net_tune_targets)
  echo "(* = already at target)"
  if [[ -f "$NET_TUNE_CONF" ]]; then
    echo "sysctl file: ${NET_TUNE_CONF} (present)"
  else
    echo "sysctl file: ${NET_TUNE_CONF} (absent - run: wgpanel tune apply)"
  fi
  iface="$(net_tune_default_iface)"
  if [[ -n "$iface" ]] && command -v ethtool >/dev/null 2>&1; then
    echo "NIC ${iface}: $(ethtool -k "$iface" 2>/dev/null | grep -E '^(rx-udp-gro-forwarding|rx-gro-list):' | tr -s ' ' | tr '\n' ' ')"
  else
    echo "NIC: ethtool not available"
  fi
  if command -v systemctl >/dev/null 2>&1; then
    echo "wgpanel-net-tune.service: $(systemctl is-enabled wgpanel-net-tune.service 2>/dev/null || echo not-installed)"
  fi
}

net_tune_revert() {
  local key value
  if command -v systemctl >/dev/null 2>&1; then
    systemctl disable --now wgpanel-net-tune.service >/dev/null 2>&1 || true
  fi
  rm -f "$NET_TUNE_UNIT" "$NET_TUNE_NIC_SCRIPT" "$NET_TUNE_CONF"
  command -v systemctl >/dev/null 2>&1 && { systemctl daemon-reload >/dev/null 2>&1 || true; }
  if [[ -f "$NET_TUNE_PREV" ]]; then
    while read -r key value; do
      sysctl -q -w "${key}=${value}" >/dev/null 2>&1 || true
    done < "$NET_TUNE_PREV"
    rm -f "$NET_TUNE_PREV"
    log "Network tuning removed and the previous kernel values restored."
  else
    log "Network tuning files removed (no saved values; kernel settings return to default on reboot)."
  fi
  return 0
}
# <<< wgpanel net-tune

main() {
  local cmd="${1:-}"
  [[ $# -gt 0 ]] && shift || true
  case "$cmd" in
    start) cmd_start ;;
    stop) cmd_stop ;;
    restart) cmd_restart "$@" ;;
    status) cmd_status ;;
    logs) cmd_logs "$@" ;;
    update) cmd_update ;;
    rollback) cmd_rollback ;;
    backup) cmd_backup ;;
    restore) cmd_restore "$@" ;;
